# Copy to .env and fill in. Never commit .env (it holds live secrets).
# Render: set these same names in the dashboard instead of using this file.

# vg cookie from your browser: vivarium.su > DevTools > Application > Cookies.
# ~30d validity. Refreshed automatically when possible; this is the seed value.
VIVARIUM_VG=

# Optional crypto overrides. Leave empty: they are re-derived from the site's
# own JS in the background and hot-swap in on their own.
VIVARIUM_U_HEX=
VIVARIUM_XCV=

# Password for protected admin and signed-request-kit endpoints.
VIVARIUM_ADMIN_PASSWORD=
