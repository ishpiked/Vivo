{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Local Vivarium API",
			"type": "shell",
			"command": ".\\.venv\\Scripts\\python.exe",
			"args": [
				"-m",
				"uvicorn",
				"api:app",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run Vivarium unit tests",
			"type": "shell",
			"command": ".\\.venv\\Scripts\\python.exe",
			"args": [
				"-m",
				"unittest",
				"test",
				"-v"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}